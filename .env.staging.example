# Nur für eine isolierte lokale Staging-Vorschau. Eigene Werte in .env.staging setzen.
COMPOSE_PROJECT_NAME=nordwinds-staging
APP_NAME=NordWinds
APP_ENV=staging
APP_PUBLIC_ORIGIN=https://staging.localhost:18443
STAGING_HOST=staging.localhost
HOST_HTTP_PORT=18443
HOST_MAILPIT_PORT=18026
NORDWINDS_BACKUP_DIR=./backups-staging
POSTGRES_DB=nordwinds_staging
POSTGRES_USER=nordwinds_staging_owner
POSTGRES_PASSWORD=hier-ein-eigenes-starkes-passwort-setzen
NORDWINDS_DB_RUNTIME_USER=nordwinds_runtime
NORDWINDS_DB_RUNTIME_PASSWORD=hier-ein-anderes-passwort-mit-mindestens-32-zeichen-setzen
NORDWINDS_METRICS_TOKEN=hier-einen-metrik-token-mit-mindestens-32-zeichen-setzen
NORDWINDS_DEMO_CHECKOUT_ENABLED=false
