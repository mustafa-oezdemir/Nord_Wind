# Copy to .env for local development. Never commit real credentials.
# Public shop identity; technical identifiers use ASCII for portability.
APP_NAME="Kuzey Rüzgarları"
APP_SLUG=kuzey-ruzgarlari
APP_ENV=development
APP_LOCALE=de-DE
APP_CURRENCY=EUR
APP_TIMEZONE=Europe/Berlin

# Docker Compose / HTTP
COMPOSE_PROJECT_NAME=kuzey-ruzgarlari
HOST_HTTP_PORT=8080
API_HTTP_PORT=8080

# PostgreSQL: only the API and database containers should use this network.
POSTGRES_DB=kuzey_ruzgarlari
POSTGRES_USER=kuzey_app
POSTGRES_PASSWORD=replace-with-a-unique-random-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Structured application logging
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_SERVICE_NAME=kuzey-ruzgarlari-api
