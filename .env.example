# Für die lokale Entwicklung nach .env kopieren. Echte Zugangsdaten nie committen.
# Öffentlicher Shopname; technische Bezeichner nutzen aus Kompatibilitätsgründen ASCII.
APP_NAME="Kuzey Rüzgarları"
APP_SLUG=kuzey-ruzgarlari
APP_ENV=development
APP_LOCALE=de-DE
APP_CURRENCY=EUR
APP_TIMEZONE=Europe/Berlin

# Docker Compose / HTTP
COMPOSE_PROJECT_NAME=kuzey-ruzgarlari
HOST_HTTP_PORT=8080
API_HTTP_PORT=8080

# PostgreSQL: Nur API und Datenbank sollen dieses interne Netzwerk nutzen.
POSTGRES_DB=kuzey_ruzgarlari
POSTGRES_USER=kuzey_app
POSTGRES_PASSWORD=hier-ein-eigenes-starkes-passwort-setzen
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Strukturierte Anwendungsprotokolle
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_SERVICE_NAME=kuzey-ruzgarlari-api
