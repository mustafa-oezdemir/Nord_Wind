# Für die lokale Entwicklung nach .env kopieren. Echte Zugangsdaten nie committen.
# Öffentlicher Shopname und technische Bezeichner.
APP_NAME=NordWinds
APP_SLUG=nordwinds
APP_ENV=development
# Nur für lokale Testbestellungen bewusst auf true setzen. Live-Verkäufe bleiben gesperrt.
NORDWINDS_DEMO_CHECKOUT_ENABLED=false
APP_PUBLIC_ORIGIN=http://localhost:8080
APP_LOCALE=de-DE
APP_CURRENCY=EUR
APP_TIMEZONE=Europe/Berlin

# Optional: mindestens 32 Zeichen für externe signierte Mock-Webhooks.
# Ohne Wert erzeugt die API bei jedem Start einen neuen lokalen Testschlüssel.
NORDWINDS_MOCK_WEBHOOK_SECRET=

# Docker Compose / HTTP
COMPOSE_PROJECT_NAME=nordwinds
HOST_HTTP_PORT=8080
API_HTTP_PORT=8080
# Mailpit-Oberfläche (lokales Testpostfach) unter http://127.0.0.1:8025
HOST_MAILPIT_PORT=8025

# E-Mail (ADR-011). Lokal fängt Mailpit alles ab; nichts erreicht echte Postfächer.
MAIL_TRANSPORT=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none
MAIL_FROM=NordWinds <no-reply@nordwinds.local>
# Produktion: eigener Anbieter mit TLS und Zugangsdaten, z. B.
# SMTP_HOST=smtp.anbieter.example  SMTP_PORT=587  SMTP_TLS=starttls
# SMTP_USERNAME=…  SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# MAIL_FROM=NordWinds <no-reply@ihre-domain.de>  MAIL_REPLY_TO=service@ihre-domain.de

# PostgreSQL: Nur API, Migration und Datenbank nutzen das private Netzwerk.
POSTGRES_DB=nordwinds
POSTGRES_USER=nordwinds_app
POSTGRES_PASSWORD=hier-ein-eigenes-starkes-passwort-setzen
# Vor einem produktiven Betrieb eigene starke Zugangsdaten setzen.
# Der Migrationsjob legt die Rolle an; die API verwendet nur diese Rolle.
NORDWINDS_DB_RUNTIME_USER=
NORDWINDS_DB_RUNTIME_PASSWORD=
# Optional: mindestens 32 Zeichen; aktiviert /internal/metrics nur mit Bearer-Token.
# Für das Monitoring unten erforderlich.
NORDWINDS_METRICS_TOKEN=
# Optional: separates Hostverzeichnis für die Datenbanksicherung.
NORDWINDS_BACKUP_DIR=./backups
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Monitoring mit Prometheus und Grafana (ADR-012). Einschalten mit COMPOSE_PROFILES=monitoring.
#   Prometheus: https://127.0.0.1:9090 – TLS mit lokaler CA, Anmeldung PROMETHEUS_USER/PROMETHEUS_PASSWORD
#   Grafana:    http://127.0.0.1:3000  – Anmeldung GRAFANA_ADMIN_USER/GRAFANA_ADMIN_PASSWORD
# Passwörter: mindestens 16 Zeichen ohne Leerzeichen; Datenbank-Monitorrolle mindestens 32 Zeichen.
COMPOSE_PROFILES=
HOST_PROMETHEUS_PORT=9090
HOST_GRAFANA_PORT=3000
PROMETHEUS_RETENTION=15d
PROMETHEUS_USER=nordwinds_prometheus
PROMETHEUS_PASSWORD=hier-ein-eigenes-starkes-passwort-setzen
GRAFANA_ADMIN_USER=nordwinds_admin
GRAFANA_ADMIN_PASSWORD=hier-ein-eigenes-starkes-passwort-setzen
# Lesende Rolle für den PostgreSQL-Exporter (pg_monitor, kein Zugriff auf Shopdaten).
# migrate legt sie nur an, wenn ein eigenes Passwort mit mindestens 32 Zeichen gesetzt ist.
NORDWINDS_DB_MONITOR_USER=nordwinds_monitor
NORDWINDS_DB_MONITOR_PASSWORD=

# Strukturierte Anwendungsprotokolle
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_SERVICE_NAME=nordwinds-api
